---
import MobileMenu from "@components/mobile-menu.astro";
import SearchBox from "@components/search-box.astro";
import { menuLinks, siteConfig } from "@site-config";
import { isActivePath } from "@utils/navigation";

const url = new URL(Astro.request.url);
const isActive = (path: string) => isActivePath(url.pathname, path);
---

<header
  id="main-header"
  class="relative mb-16 flex items-end justify-between gap-2 z-40"
>
  <div class="flex flex-1 items-end gap-2 sm:flex-none">
    <a
      aria-label={`${siteConfig.siteTitle} — home`}
      class="shrink-0 rounded-md transition-opacity duration-200 hover:opacity-80"
      data-astro-prefetch
      href="/"
    >
      <img alt="" aria-hidden="true" class="h-14 w-14" height="56" src="/favicon.svg" width="56" />
    </a>

    <nav
      aria-label="Main menu"
      class="hidden sm:flex divide-x divide-dashed pt-0 primary"
      id="navigation-menu"
    >
      {
        menuLinks.map((link) => (
          <a
            aria-current={isActive(link.path) ? "page" : false}
            aria-label={`Navigate to ${link.title} page`}
            class={`px-4 py-0 wavy-hover divide-primary${isActive(link.path) ? " wavy-underline" : ""}`}
            data-astro-prefetch
            href={link.path}
          >
            {link.title}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="flex items-center">
    <SearchBox />
    <MobileMenu />
  </div>
</header>
